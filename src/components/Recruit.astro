---
import type { Recruit } from '../lib/microcms';

export interface Props {
  recruit: Recruit;
}

const { recruit } = Astro.props;

const rows = [
  { label: '仕事内容', value: recruit.jobDescription },
  { label: '給与・時給', value: recruit.wage },
  { label: '勤務時間', value: recruit.shift },
  { label: '応募方法', value: recruit.howToApply },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

<div class="signboard mx-auto max-w-2xl px-6 py-7">
  <dl class="text-sm sm:text-base">
    {
      rows.map((row, i) => (
        <div
          class:list={[
            'grid grid-cols-[6rem_1fr] gap-3 py-3',
            i < rows.length - 1 ? 'border-b border-dashed border-kogecha/30' : '',
          ]}
        >
          <dt class="heading text-kogecha-dim">{row.label}</dt>
          <dd class="whitespace-pre-line text-kogecha">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
