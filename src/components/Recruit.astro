---
import type { Recruit } from '../lib/microcms';

export interface Props {
  recruit: Recruit;
}

const { recruit } = Astro.props;

// 店舗案内と同じ罫線の組みで揃える
const rows = [
  { label: '仕事内容', value: recruit.jobDescription },
  { label: '給与・時給', value: recruit.wage },
  { label: '勤務時間', value: recruit.shift },
  { label: '応募方法', value: recruit.howToApply },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

<dl class="max-w-2xl text-sm sm:text-base">
  {
    rows.map((row) => (
      <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-tetsu-line py-4">
        <dt class="text-paper-dim">{row.label}</dt>
        <dd class="whitespace-pre-line text-paper">{row.value}</dd>
      </div>
    ))
  }
</dl>
