---
import type { Recruit } from '../lib/microcms';

export interface Props {
  recruit: Recruit;
}

const { recruit } = Astro.props;

// 店舗情報と同じ罫線の組みで揃える
const rows = [
  { label: '仕事内容', value: recruit.jobDescription },
  { label: '給与・時給', value: recruit.wage },
  { label: '勤務時間', value: recruit.shift },
  { label: '応募方法', value: recruit.howToApply },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

<dl class="reveal max-w-2xl border-t border-kinari-line text-[0.9375rem] sm:text-base">
  {
    rows.map((row) => (
      <div class="grid grid-cols-[6rem_1fr] gap-4 border-b border-kinari-line py-4 sm:grid-cols-[6.5rem_1fr]">
        <dt class="text-rikyu">{row.label}</dt>
        <dd class="whitespace-pre-line text-sumi">{row.value}</dd>
      </div>
    ))
  }
</dl>
