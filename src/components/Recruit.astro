---
import type { Recruit } from '../lib/microcms';

export interface Props {
  recruit: Recruit;
}

const { recruit } = Astro.props;
---

<div class="mx-auto max-w-2xl space-y-6 text-stone-700">
  {
    recruit.jobDescription && (
      <div>
        <h3 class="mb-1 font-semibold text-stone-900">仕事内容</h3>
        <p class="whitespace-pre-line">{recruit.jobDescription}</p>
      </div>
    )
  }
  {
    recruit.wage && (
      <div>
        <h3 class="mb-1 font-semibold text-stone-900">給与・時給</h3>
        <p class="whitespace-pre-line">{recruit.wage}</p>
      </div>
    )
  }
  {
    recruit.shift && (
      <div>
        <h3 class="mb-1 font-semibold text-stone-900">勤務時間・シフト</h3>
        <p class="whitespace-pre-line">{recruit.shift}</p>
      </div>
    )
  }
  {
    recruit.howToApply && (
      <div>
        <h3 class="mb-1 font-semibold text-stone-900">応募方法</h3>
        <p class="whitespace-pre-line">{recruit.howToApply}</p>
      </div>
    )
  }
</div>
