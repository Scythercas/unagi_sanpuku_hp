---
export interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

{/* 一言紹介の下に置く目次。各セクションへページ内リンクで移動する */}
<nav aria-label="目次" class="bg-kinari px-5 pb-16 sm:pb-20">
  <ul class="mx-auto flex max-w-5xl flex-wrap justify-center gap-x-6 gap-y-1 sm:gap-x-14">
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} class="index-link inline-block py-2 text-base text-sumi sm:text-lg">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
