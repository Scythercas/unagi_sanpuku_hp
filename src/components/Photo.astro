---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// 写真が無い箇所を「撮影予定」のダミー面で埋める。写真の有無をここで吸収するので、
// 呼び出し側は分岐を書かずに済む。本番写真と見間違えないよう用途を必ず明記する。
export interface Props {
  image?: ImageMetadata;
  alt: string;
  /** ダミー時に表示する撮影内容（例：うな重・上から） */
  shootNote: string;
  /** アスペクト比の Tailwind クラス（例：aspect-[4/3]） */
  aspect?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  image,
  alt,
  shootNote,
  aspect = 'aspect-[4/3]',
  widths = [400, 800, 1200],
  sizes = '100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      class:list={[aspect, 'w-full object-cover', className]}
    />
  ) : (
    <div class:list={['dummy', aspect, 'w-full', className]}>
      <span class="heading text-[0.65rem] text-paper-dim">撮影予定</span>
      <span class="text-sm leading-snug text-paper-dim">{shootNote}</span>
    </div>
  )
}
