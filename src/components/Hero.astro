---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  shopName: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
}

const { shopName, heroImage, heroAlt } = Astro.props;

// TODO: お店から提供された実際の調理動画に差し替える（docs/【さんぷく様HP製作】お店へのお願い.pdf 参照）
const heroVideoSrc = '/videos/hero-cooking-placeholder.mp4';

// 動画の読み込み完了までのポスター、および prefers-reduced-motion 時の代替に使う
const posterSrc = heroImage
  ? (await getImage({ src: heroImage, width: 1600, format: 'jpg' })).src
  : undefined;
---

<section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-stone-900 text-white">
  <video
    class="hero-video absolute inset-0 h-full w-full object-cover opacity-90"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={posterSrc}
  >
    <source src={heroVideoSrc} type="video/mp4" />
  </video>

  {
    heroImage && (
      <Image
        src={heroImage}
        alt={heroAlt ?? shopName}
        widths={[400, 800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-fallback-image absolute inset-0 h-full w-full object-cover opacity-90"
      />
    )
  }

  <div class="absolute inset-0 bg-gradient-to-b from-stone-900/50 via-stone-900/20 to-stone-900/70"></div>

  <div class="hero-reveal relative z-10 px-4 text-center">
    <p class="text-sm tracking-[0.4em] text-amber-200">北高崎 うなぎ</p>
    <h1 class="font-brush mt-4 text-6xl leading-none tracking-wide sm:text-8xl">
      {shopName}
    </h1>
  </div>
</section>
