---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  shopName: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
}

const { shopName, heroImage, heroAlt } = Astro.props;

// TODO: お店から提供された実際の調理動画に差し替える（docs/【さんぷく様HP製作】お店へのお願い.pdf 参照）
const heroVideoSrc = '/videos/hero-cooking-placeholder.mp4';

// 動画の読み込み完了までのポスター、および prefers-reduced-motion 時の代替に使う
const posterSrc = heroImage
  ? (await getImage({ src: heroImage, width: 1600, format: 'jpg' })).src
  : undefined;
---

<section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-sumi text-kinari">
  <video
    class="hero-video absolute inset-0 h-full w-full object-cover opacity-90"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={posterSrc}
  >
    <source src={heroVideoSrc} type="video/mp4" />
  </video>

  {
    heroImage && (
      <Image
        src={heroImage}
        alt={heroAlt ?? shopName}
        widths={[400, 800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-fallback-image absolute inset-0 h-full w-full object-cover opacity-90"
      />
    )
  }

  <div class="absolute inset-0 bg-gradient-to-b from-sumi/60 via-sumi/25 to-sumi/80"></div>

  <div class="hero-reveal relative z-10 px-5 text-center">
    <p class="section-label text-xs text-sumi-weak sm:text-sm">北高崎 うなぎ</p>
    {/* 紙面へ続く一本の罫。弁柄はここと本編の区切りだけに使う */}
    <div class="mx-auto my-7 h-px w-10 bg-bengara"></div>
    <h1 class="font-brush text-6xl leading-none tracking-wide sm:text-8xl">
      {shopName}
    </h1>
  </div>
</section>
