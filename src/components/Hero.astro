---
export interface Props {
  shopName: string;
  catchcopy?: string;
}

const { shopName, catchcopy } = Astro.props;

// 写真は使わず、円と斜ストライプで組んだ看板として見せる。
// 写真が4枚しかなくても画面が持つのが狙い。
---

<section class="stripe relative overflow-hidden bg-cream px-5 py-24 sm:py-32">
  {/* 背景の円。装飾なので読み上げ対象から外す */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="bob absolute -left-16 top-10 h-56 w-56 rounded-full bg-midori/90"></div>
    <div class="bob-slow absolute -right-10 top-40 h-40 w-40 rounded-full bg-shu/90"></div>
    <div class="bob absolute bottom-6 left-1/3 h-24 w-24 rounded-full bg-karashi"></div>
  </div>

  <div class="relative mx-auto max-w-3xl">
    <div class="signboard px-6 py-12 text-center sm:px-12 sm:py-16">
      <p class="heading text-sm text-shu sm:text-base">うなぎのお店</p>

      <h1 class="heading mt-5 text-5xl leading-tight tracking-[0.16em] text-kogecha sm:text-7xl">
        {shopName}
      </h1>

      <div class="mt-7 flex items-center justify-center gap-3" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-shu"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-karashi"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-midori"></span>
      </div>

      <p class="heading mt-7 text-base text-kogecha sm:text-lg">創業以来の味</p>

      {
        catchcopy && (
          <p class="mx-auto mt-6 max-w-md whitespace-pre-line text-sm leading-loose text-kogecha-dim sm:text-base">
            {catchcopy}
          </p>
        )
      }
    </div>
  </div>
</section>
