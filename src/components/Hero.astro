---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

export interface Props {
  shopName: string;
  heroImage?: ImageMetadata;
}

const { shopName, heroImage } = Astro.props;
---

{/* 高さは画面の8割。下に次のセクションの頭を覗かせ、スクロールできることを示す */}
<section class="relative h-[82svh] overflow-hidden bg-tetsu">
  <Photo
    image={heroImage}
    alt={shopName}
    shootNote="ヒーロー用：鰻を焼いている手元（横位置）"
    aspect="h-full"
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0"
  />

  {/* 文字は写真に重ねない方針だが、店名だけは下端に置く。
      写真の明暗に左右されないよう、地色へ確実に沈めてから載せる。 */}
  <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-tetsu to-transparent"></div>

  <div class="absolute inset-x-0 bottom-0 px-5 pb-14">
    <div class="mx-auto max-w-5xl">
      <p class="heading text-[0.7rem] text-paper-dim sm:text-xs">北高崎 うなぎ</p>
      <h1 class="shopname mt-4 text-4xl text-paper sm:text-6xl">{shopName}</h1>
    </div>
  </div>

  <div class="scroll-hint absolute inset-x-0 bottom-4 flex justify-center" aria-hidden="true">
    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="text-paper-dim">
      <path d="M1 1l8 7 8-7" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </div>
</section>
