---
import { Image } from 'astro:assets';
import type { GalleryItem } from '../lib/microcms';
import { GALLERY_TYPES } from '../lib/microcms';
import { getLocalImage, imageMap } from '../lib/images';

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;

// 種別順（外観→内装→調理→料理）に並べる。写真が少ないので切り替えは設けず、
// 焦茶の枠と影を付けて「貼った写真」のように見せる。
const ordered = [...items].sort((a, b) => {
  const byType = GALLERY_TYPES.indexOf(a.type) - GALLERY_TYPES.indexOf(b.type);
  return byType !== 0 ? byType : a.order - b.order;
});
---

<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 sm:gap-6">
  {
    ordered.map((item, i) => {
      const image = getLocalImage(imageMap.gallery[item.id]?.localPath);
      if (!image) return null;
      return (
        <li>
          <div
            class="overflow-hidden rounded-2xl border-[3px] border-kogecha bg-cream shadow-[5px_5px_0_var(--color-kogecha)]"
            style={`transform: rotate(${i % 2 === 0 ? '-1' : '1'}deg)`}
          >
            <Image
              src={image}
              alt={item.caption ?? item.type}
              widths={[400, 800]}
              sizes="(min-width: 640px) 33vw, 50vw"
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
          <p class="mt-3 text-center text-xs text-kogecha-dim">
            {item.caption ?? item.type}
          </p>
        </li>
      );
    })
  }
</ul>
