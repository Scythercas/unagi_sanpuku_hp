---
import { Image } from 'astro:assets';
import type { GalleryGroup } from '../lib/content';
import { getLocalImage, imageMap } from '../lib/images';
import TabsScript from './TabsScript.astro';

export interface Props {
  groups: GalleryGroup[];
}

const { groups } = Astro.props;
---

<div data-tabs>
  <div class="mb-12 flex flex-wrap gap-x-8 gap-y-3 border-b border-kinari-line" role="tablist">
    {
      groups.map((group, i) => (
        <button
          type="button"
          role="tab"
          id={`gallery-tab-${group.type}`}
          aria-controls={`gallery-panel-${group.type}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab-button
          data-target={`gallery-panel-${group.type}`}
          class="tab -mb-px text-sm sm:text-base"
        >
          {group.type}
        </button>
      ))
    }
  </div>
  {
    groups.map((group, i) => (
      <div
        id={`gallery-panel-${group.type}`}
        role="tabpanel"
        aria-labelledby={`gallery-tab-${group.type}`}
        data-tab-panel
        hidden={i !== 0}
      >
        <ul class="album">
          {group.items.map((item) => {
            const image = getLocalImage(imageMap.gallery[item.id]?.localPath);
            if (!image) return null;
            // 縦横比。行内の伸び率と基準幅に使う（global.css の .album-item）
            const ratio = image.width / image.height;
            // 表示幅の上限の目安：基準の行高（120px / 220px）から行内で最大1.5倍まで伸びる（global.css の max-width）
            const sizes = `(min-width: 640px) ${Math.ceil(ratio * 220 * 1.5)}px, ${Math.ceil(ratio * 120 * 1.5)}px`;
            return (
              <li class="album-item" style={`--r: ${ratio.toFixed(4)}`}>
                <figure>
                  <Image
                    src={image}
                    alt={item.caption ?? group.type}
                    widths={[400, 800]}
                    sizes={sizes}
                    loading="lazy"
                    class="block h-auto w-full"
                  />
                  {item.caption && (
                    <figcaption class="mt-2 text-xs text-rikyu">{item.caption}</figcaption>
                  )}
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>
<TabsScript />
