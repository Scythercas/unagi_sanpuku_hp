---
import { Image } from 'astro:assets';
import type { GalleryGroup } from '../lib/content';
import { getLocalImage, imageMap } from '../lib/images';
import TabsScript from './TabsScript.astro';

export interface Props {
  groups: GalleryGroup[];
}

const { groups } = Astro.props;
---

<div data-tabs>
  <div class="mb-12 flex flex-wrap gap-x-8 gap-y-3 border-b border-kinari-line" role="tablist">
    {
      groups.map((group, i) => (
        <button
          type="button"
          role="tab"
          id={`gallery-tab-${group.type}`}
          aria-controls={`gallery-panel-${group.type}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab-button
          data-target={`gallery-panel-${group.type}`}
          class="tab -mb-px text-sm sm:text-base"
        >
          {group.type}
        </button>
      ))
    }
  </div>
  {
    groups.map((group, i) => (
      <div
        id={`gallery-panel-${group.type}`}
        role="tabpanel"
        aria-labelledby={`gallery-tab-${group.type}`}
        data-tab-panel
        hidden={i !== 0}
      >
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
          {group.items.map((item) => {
            const image = getLocalImage(imageMap.gallery[item.id]?.localPath);
            if (!image) return null;
            return (
              <li>
                <Image
                  src={image}
                  alt={item.caption ?? group.type}
                  widths={[400, 800]}
                  sizes="(min-width: 640px) 33vw, 50vw"
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover"
                />
                {item.caption && <p class="mt-2 text-xs text-rikyu">{item.caption}</p>}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>
<TabsScript />
