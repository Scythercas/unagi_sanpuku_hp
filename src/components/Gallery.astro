---
import { Image } from 'astro:assets';
import type { GalleryGroup } from '../lib/content';
import { getLocalImage, imageMap } from '../lib/images';

export interface Props {
  groups: GalleryGroup[];
}

const { groups } = Astro.props;

// 種別（外観→内装→調理→料理）の順を保ったまま一枚の紙面に並べる
const items = groups.flatMap((group) =>
  group.items.map((item) => ({ item, type: group.type }))
);
---

{/* 写真は縦長が多いため、決まった比率で切り抜かず元の縦横比のまま段組みに流す
    （店構えの看板や座敷の天井が切れないように）。width/height は元画像から出力されるため CLS は出ない。 */}
<ul class="columns-2 gap-4 sm:gap-6 lg:columns-4">
  {
    items.map(({ item, type }) => {
      const image = getLocalImage(imageMap.gallery[item.id]?.localPath);
      if (!image) return null;
      return (
        <li class="reveal mb-6 break-inside-avoid sm:mb-8">
          <figure>
            <Image
              src={image}
              alt={item.caption ?? type}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 230px, (min-width: 640px) 45vw, 50vw"
              loading="lazy"
              class="h-auto w-full"
            />
            <figcaption class="mt-2 flex flex-wrap items-baseline gap-x-3 text-sm">
              <span class="section-label text-xs text-rikyu">{type}</span>
              {item.caption && <span class="text-sumi">{item.caption}</span>}
            </figcaption>
          </figure>
        </li>
      );
    })
  }
</ul>
