---
import { Image } from 'astro:assets';
import type { GalleryGroup } from '../lib/content';
import { getLocalImage, imageMap } from '../lib/images';
import TabsScript from './TabsScript.astro';

export interface Props {
  groups: GalleryGroup[];
}

const { groups } = Astro.props;
---

<div data-tabs>
  <div class="mb-8 flex flex-wrap justify-center gap-2" role="tablist">
    {
      groups.map((group, i) => (
        <button
          type="button"
          role="tab"
          id={`gallery-tab-${group.type}`}
          aria-controls={`gallery-panel-${group.type}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab-button
          data-target={`gallery-panel-${group.type}`}
          class:list={[
            'rounded-full border px-4 py-1.5 text-sm font-medium transition',
            i === 0
              ? ['border-amber-500', 'bg-amber-500', 'text-stone-900']
              : ['border-stone-300', 'text-stone-600'],
          ]}
        >
          {group.type}
        </button>
      ))
    }
  </div>
  {
    groups.map((group, i) => (
      <div
        id={`gallery-panel-${group.type}`}
        role="tabpanel"
        aria-labelledby={`gallery-tab-${group.type}`}
        data-tab-panel
        hidden={i !== 0}
      >
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {group.items.map((item) => {
            const image = getLocalImage(imageMap.gallery[item.id]?.localPath);
            if (!image) return null;
            return (
              <li class="overflow-hidden rounded-lg">
                <Image
                  src={image}
                  alt={item.caption ?? group.type}
                  widths={[400, 800]}
                  sizes="(min-width: 640px) 33vw, 50vw"
                  loading="lazy"
                  class="aspect-[4/3] h-full w-full object-cover transition duration-300 hover:scale-105"
                />
                {item.caption && <p class="mt-1 text-xs text-stone-500">{item.caption}</p>}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>
<TabsScript />
