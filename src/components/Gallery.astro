---
import type { GalleryItem } from '../lib/microcms';
import { GALLERY_TYPES } from '../lib/microcms';
import { getLocalImage, imageMap } from '../lib/images';
import Photo from './Photo.astro';

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;

// 種別の並び順（外観→内装→調理→料理）で見せる。タブは無いので、
// 順番そのものが店の外から中へ入っていく流れになるよう並べ替える。
const ordered = [...items].sort((a, b) => {
  const byType = GALLERY_TYPES.indexOf(a.type) - GALLERY_TYPES.indexOf(b.type);
  return byType !== 0 ? byType : a.order - b.order;
});

// 撮影待ちの枠。写真が増えたぶんだけ手前から埋まり、余った枠だけダミーで残る。
const WANTED = [
  { type: '外観', note: '外観（引きで建物全景）' },
  { type: '内装', note: '座敷（人がいない状態で）' },
  { type: '内装', note: 'カウンター席' },
  { type: '調理', note: '焼き場の手元（寄り）' },
  { type: '料理', note: 'うな重の蓋を開けたところ' },
  { type: '料理', note: '一品料理の盛り付け' },
] as const;

const missingCount = Math.max(0, WANTED.length - ordered.length);
const dummies = WANTED.slice(WANTED.length - missingCount);
---

<div class="hscroll px-5 pb-4">
  {
    ordered.map((item) => (
      <figure class="w-[78vw] max-w-[26rem]">
        <Photo
          image={getLocalImage(imageMap.gallery[item.id]?.localPath)}
          alt={item.caption ?? item.type}
          shootNote={item.type}
          aspect="aspect-[4/3]"
          widths={[400, 800]}
          sizes="(min-width: 640px) 26rem, 78vw"
        />
        <figcaption class="mt-3 flex items-baseline gap-3">
          <span class="heading text-[0.65rem] text-paper-dim">{item.type}</span>
          {item.caption && <span class="text-sm text-paper-dim">{item.caption}</span>}
        </figcaption>
      </figure>
    ))
  }
  {
    dummies.map((wanted) => (
      <figure class="w-[78vw] max-w-[26rem]">
        <Photo alt={wanted.note} shootNote={wanted.note} aspect="aspect-[4/3]" />
        <figcaption class="mt-3">
          <span class="heading text-[0.65rem] text-paper-dim">{wanted.type}</span>
        </figcaption>
      </figure>
    ))
  }
  {/* 右端に余白を作り、最後の1枚が画面端に貼り付かないようにする */}
  <div class="w-1" aria-hidden="true"></div>
</div>
