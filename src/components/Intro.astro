---
export interface Props {
  catchcopy?: string;
}

const { catchcopy } = Astro.props;
---

{
  catchcopy && (
    <section id="about" class="bg-kinari px-5 pt-24 pb-16 sm:pt-32 sm:pb-20">
      <div class="mx-auto flex max-w-5xl justify-center">
        {/* モバイルは横組み・中央揃え、デスクトップは縦組みで天（上端）揃え */}
        <p class="intro-vertical reveal whitespace-pre-line text-center text-lg leading-[2.4] tracking-[0.12em] text-sumi sm:text-start sm:text-xl sm:leading-[2.2]">
          {catchcopy}
        </p>
      </div>
    </section>
  )
}
