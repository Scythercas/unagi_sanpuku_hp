---
export interface Props {
  id?: string;
  /** セクション見出し */
  label?: string;
  /** 一段沈めた地にする（区切りとして使う） */
  deep?: boolean;
  /** 横スクロール等で内側を画面幅いっぱいに使いたいとき、最大幅の枠を外す */
  bleed?: boolean;
  class?: string;
}

const { id, label, deep = false, bleed = false, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'py-24 sm:py-32',
    bleed ? '' : 'px-5',
    deep ? 'bg-tetsu-deep' : 'bg-tetsu',
    className,
  ]}
>
  <div class:list={[bleed ? '' : 'mx-auto max-w-5xl']}>
    {
      label && (
        <div class:list={['mb-14', bleed ? 'mx-auto max-w-5xl px-5' : '']}>
          <h2 class="heading text-sm text-paper sm:text-base">{label}</h2>
          <div class="mt-5 h-px w-full bg-tetsu-line" />
        </div>
      )
    }
    <slot />
  </div>
</section>
