---
export interface Props {
  id?: string;
  /** セクション見出し。デスクトップでは紙面の左端に縦書きで置かれる */
  label?: string;
  /** 墨地のセクション（既定は生成りの紙面） */
  dark?: boolean;
  class?: string;
}

const { id, label, dark = false, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-4 px-5',
    dark ? 'on-sumi bg-sumi text-kinari' : 'bg-kinari text-sumi',
    className,
  ]}
>
  {/* セクション同士は紙面幅いっぱいの細罫で区切る（品書きの段の区切りに倣う） */}
  <div
    class:list={[
      'mx-auto max-w-5xl border-t py-20 sm:py-24',
      dark ? 'border-sumi-line' : 'border-kinari-line',
    ]}
  >
    {
      label ? (
        <div class="sm:flex sm:gap-12">
          {/* 見出し：デスクトップは縦書きで左端、モバイルは横書きで上 */}
          <div class="reveal mb-10 flex-none sm:mb-0 sm:w-12">
            <h2
              class:list={[
                'section-label section-label-vertical text-xl sm:text-2xl lg:text-[1.75rem]',
                dark ? 'text-kinari' : 'text-sumi',
              ]}
            >
              {label}
            </h2>
            <div class="mt-4 h-px w-8 bg-bengara sm:mt-6 sm:ml-[0.6em] sm:h-10 sm:w-px" />
          </div>
          <div class="min-w-0 flex-1">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )
    }
  </div>
</section>
