---
export interface Props {
  id?: string;
  /** セクション見出し。丸バッジで表示する */
  label?: string;
  /** 一段沈めた地にする（区切りとして使う） */
  deep?: boolean;
  class?: string;
}

const { id, label, deep = false, class: className } = Astro.props;
---

<section
  id={id}
  class:list={['px-5 py-20 sm:py-24', deep ? 'bg-cream-deep' : 'bg-cream', className]}
>
  <div class="mx-auto max-w-5xl">
    {
      label && (
        <div class="mb-12 text-center">
          <h2 class="badge text-base sm:text-lg">
            <span aria-hidden="true" class="h-2 w-2 rounded-full bg-karashi" />
            {label}
          </h2>
        </div>
      )
    }
    <slot />
  </div>
</section>
