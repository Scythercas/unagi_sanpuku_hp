---
import type { MenuGroup } from '../lib/content';
import MenuItemRow from './MenuItemRow.astro';

export interface Props {
  groups: MenuGroup[];
}

const { groups } = Astro.props;

// 品数の多いカテゴリ（一品料理30品・御飲物17品など）は、最初の数品だけ見せて残りを畳む。
// 全品を開いたままだとスマホでお品書きだけで画面7枚分になるため。
// 鰻の品（うな丼・うな重・定食）は品数が少なく、常に全品が見える。
const FOLD_OVER = 10;
const PREVIEW = 6;
---

{/* 全カテゴリの見出しを一度に見せる（タブで隠すと、品数の少ないカテゴリが1品だけの寂しい紙面になる）。
    768px 以上は2段組みにし、カテゴリの途中で段を割らない。 */}
<div class="gap-16 md:columns-2">
  {
    groups.map((group) => {
      const folds = group.items.length > FOLD_OVER;
      const shown = folds ? group.items.slice(0, PREVIEW) : group.items;
      const rest = folds ? group.items.slice(PREVIEW) : [];
      return (
        <section
          class="reveal mb-14 break-inside-avoid last:mb-0"
          aria-labelledby={`menu-${group.category}`}
        >
          <h3
            id={`menu-${group.category}`}
            class="section-label mb-6 flex items-center gap-4 text-base text-sumi sm:text-lg"
          >
            {group.category}
            <span class="h-px flex-1 bg-kinari-line" aria-hidden="true" />
          </h3>
          <ul class="space-y-5">
            {shown.map((item) => (
              <MenuItemRow item={item} />
            ))}
          </ul>
          {rest.length > 0 && (
            // 開閉はブラウザ標準の details に任せ、JS を使わない
            <details class="group mt-2">
              <summary class="menu-more inline-flex cursor-pointer list-none items-center gap-2 py-3 text-sm text-bengara">
                <span class="group-open:hidden">ほか{rest.length}品を見る</span>
                <span class="hidden group-open:inline">畳む</span>
                <span class="menu-more-mark" aria-hidden="true" />
              </summary>
              <ul class="mt-3 space-y-5">
                {rest.map((item) => (
                  <MenuItemRow item={item} />
                ))}
              </ul>
            </details>
          )}
        </section>
      );
    })
  }
</div>
