---
import { Image } from 'astro:assets';
import type { MenuGroup } from '../lib/content';
import { getLocalImage, imageMap } from '../lib/images';
import TabsScript from './TabsScript.astro';

export interface Props {
  groups: MenuGroup[];
}

const { groups } = Astro.props;

function formatPrice(price: number) {
  return `${price.toLocaleString('ja-JP')}円`;
}
---

<div data-tabs>
  <div class="mb-12 flex flex-wrap gap-x-8 gap-y-3 border-b border-kinari-line" role="tablist">
    {
      groups.map((group, i) => (
        <button
          type="button"
          role="tab"
          id={`menu-tab-${group.category}`}
          aria-controls={`menu-panel-${group.category}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab-button
          data-target={`menu-panel-${group.category}`}
          class="tab -mb-px text-sm sm:text-base"
        >
          {group.category}
        </button>
      ))
    }
  </div>
  {
    groups.map((group, i) => (
      <div
        id={`menu-panel-${group.category}`}
        role="tabpanel"
        aria-labelledby={`menu-tab-${group.category}`}
        data-tab-panel
        hidden={i !== 0}
      >
        <ul class="space-y-8">
          {group.items.map((item) => {
            const image = getLocalImage(imageMap.menu[item.id]?.localPath);
            return (
              <li class="flex gap-5">
                {image && (
                  <Image
                    src={image}
                    alt={item.name}
                    widths={[200, 400]}
                    sizes="112px"
                    loading="lazy"
                    class="h-28 w-28 flex-none object-cover"
                  />
                )}
                <div class="min-w-0 flex-1">
                  {/* 品名 ‥‥‥ 価格 を実際のお品書きのようにリーダー罫で結ぶ */}
                  <div class="flex items-baseline gap-2">
                    <p class="text-lg text-sumi">{item.name}</p>
                    <span class="leader" aria-hidden="true" />
                    <p class="whitespace-nowrap text-lg text-bengara tabular-nums">
                      {formatPrice(item.price)}
                    </p>
                  </div>
                  {item.description && (
                    <p class="mt-2 text-sm leading-relaxed text-rikyu">{item.description}</p>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>
<TabsScript />
