---
import type { MenuGroup } from '../lib/content';

export interface Props {
  groups: MenuGroup[];
}

const { groups } = Astro.props;

function formatPrice(price: number) {
  return `${price.toLocaleString('ja-JP')}円`;
}

// 短冊は縦書きなので、品名が長いと極端に縦長になる。
// 一定を超えたら字を小さくして、壁に貼った短冊の高さが揃って見えるようにする。
function nameSizeClass(name: string) {
  if (name.length >= 12) return 'text-sm';
  if (name.length >= 8) return 'text-base';
  return 'text-lg';
}
---

<div class="space-y-14">
  {
    groups.map((group) => (
      <div>
        <h3 class="heading mb-6 text-center text-sm text-shu sm:text-base">{group.category}</h3>
        {/* 壁に貼った短冊に見立てて並べる */}
        <ul class="flex flex-wrap justify-center gap-3 sm:gap-4">
          {group.items.map((item) => (
            <li class="tanzaku w-[5.5rem] sm:w-24">
              <p class:list={['tanzaku-name text-kogecha', nameSizeClass(item.name)]}>
                {item.name}
              </p>
              <p class="mt-3 whitespace-nowrap text-xs tabular-nums text-shu sm:text-sm">
                {formatPrice(item.price)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
