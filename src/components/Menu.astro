---
import type { MenuSplit } from '../lib/content';
import { groupMenuByCategory } from '../lib/content';
import { getLocalImage, imageMap } from '../lib/images';
import Photo from './Photo.astro';

export interface Props {
  split: MenuSplit;
}

const { split } = Astro.props;

function formatPrice(price: number) {
  return `${price.toLocaleString('ja-JP')}円`;
}

// ダミー面に出す撮影指示。品目によって撮り方が違うので、そのまま撮影依頼として
// 使えるよう具体的に書く（丼物に「湯気」、飲み物に「グラス」など）。
function shootNoteFor(name: string, category: string) {
  if (category === 'ドリンク') return `${name}（グラス単体・背景は暗めに）`;
  if (category === '一品') return `${name}（皿ごと斜め上から）`;
  return `${name}（蓋を開けた状態・真上から・湯気が見えると良い）`;
}

// 文字一覧側はカテゴリごとにまとめる（品数が増えたときに追える形にする）
const restGroups = groupMenuByCategory(split.rest);
---

{/* 代表の品：写真と品名を左右交互に組み、1品ずつ大きく見せる */}
{
  split.featured.length > 0 && (
    <ul class="space-y-20">
      {split.featured.map((item, i) => (
        <li class="items-center gap-10 sm:grid sm:grid-cols-2">
          <Photo
            image={getLocalImage(imageMap.menu[item.id]?.localPath)}
            alt={item.name}
            shootNote={shootNoteFor(item.name, item.category)}
            aspect="aspect-[4/3]"
            widths={[400, 800, 1200]}
            sizes="(min-width: 640px) 50vw, 100vw"
            class={i % 2 === 1 ? 'sm:order-2' : ''}
          />
          <div class="mt-6 sm:mt-0">
            <h3 class="heading text-xl text-paper sm:text-2xl">{item.name}</h3>
            <p class="mt-4 text-lg tabular-nums text-paper">{formatPrice(item.price)}</p>
            {item.description && (
              <p class="mt-5 whitespace-pre-line leading-[2.1] text-paper-dim">
                {item.description}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}

{/* 残りの品：写真を使わず、価格の一覧性を優先する */}
{
  restGroups.length > 0 && (
    <div class:list={[split.featured.length > 0 ? 'mt-28' : '']}>
      <div class="grid gap-x-16 gap-y-12 sm:grid-cols-2">
        {restGroups.map((group) => (
          <div>
            <h3 class="heading text-xs text-paper-dim">{group.category}</h3>
            <ul class="mt-5">
              {group.items.map((item) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-tetsu-line py-3.5">
                  <span class="text-paper">{item.name}</span>
                  <span class="whitespace-nowrap tabular-nums text-paper-dim">
                    {formatPrice(item.price)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )
}
