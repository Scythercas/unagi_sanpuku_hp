---
import type { Shop } from '../lib/microcms';
import TelLink from './TelLink.astro';

export interface Props {
  shop: Shop;
}

const { shop } = Astro.props;

// API キー不要の検索埋め込み形式（住所は CMS 側の値をそのまま使うため、
// 店舗情報が更新されても地図の位置は自動的に追従する）
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${shop.name} ${shop.address}`)}&output=embed`;

const seats = [
  shop.seatsCounter ? `カウンター ${shop.seatsCounter}席` : null,
  shop.seatsTable ? `テーブル ${shop.seatsTable}席` : null,
]
  .filter((v): v is string => Boolean(v))
  .join(' / ');

const rows: { label: string; value: string }[] = [
  { label: '営業時間', value: shop.hours },
  { label: '定休日', value: shop.closedDays },
  { label: '住所', value: shop.address },
  ...(shop.parking ? [{ label: '駐車場', value: shop.parking }] : []),
  ...(seats ? [{ label: '席数', value: seats }] : []),
  ...(shop.takeout !== undefined
    ? [{ label: 'テイクアウト', value: shop.takeout ? '対応' : '非対応' }]
    : []),
  ...(shop.delivery !== undefined
    ? [{ label: '出前', value: shop.delivery ? '対応' : '非対応' }]
    : []),
  ...(shop.accessNote ? [{ label: 'アクセス', value: shop.accessNote }] : []),
  ...(shop.notes ? [{ label: 'ご案内', value: shop.notes }] : []),
];
---

<div class="grid gap-8 sm:grid-cols-2 sm:gap-10">
  {/* 可愛くしても実用情報は読みやすさ優先。枠の中は素直な定義リストにする */}
  <div class="signboard px-6 py-7">
    <dl class="text-sm sm:text-base">
      {
        rows.map((row) => (
          <div class="grid grid-cols-[6rem_1fr] gap-3 border-b border-dashed border-kogecha/30 py-3">
            <dt class="heading text-kogecha-dim">{row.label}</dt>
            <dd class="whitespace-pre-line text-kogecha">{row.value}</dd>
          </div>
        ))
      }
      <div class="grid grid-cols-[6rem_1fr] gap-3 py-3">
        <dt class="heading text-kogecha-dim">電話</dt>
        <dd>
          <TelLink tel={shop.tel} class="text-lg font-bold tabular-nums text-shu">
            {shop.tel}
          </TelLink>
        </dd>
      </div>
    </dl>
  </div>

  <div class="overflow-hidden rounded-2xl border-[3px] border-kogecha shadow-[5px_5px_0_var(--color-kogecha)]">
    <iframe
      src={mapSrc}
      class="h-80 w-full sm:h-full sm:min-h-80"
      style="border:0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`${shop.name}の地図`}></iframe>
  </div>
</div>
