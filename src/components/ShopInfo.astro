---
import type { Shop } from '../lib/microcms';
import TelLink from './TelLink.astro';

export interface Props {
  shop: Shop;
}

const { shop } = Astro.props;

// API キー不要の検索埋め込み形式（住所は CMS 側の値をそのまま使うため、
// 店舗情報が更新されても地図の位置は自動的に追従する）
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${shop.name} ${shop.address}`)}&output=embed`;

const seats = [
  shop.seatsCounter ? `カウンター ${shop.seatsCounter}席` : null,
  shop.seatsTable ? `テーブル ${shop.seatsTable}席` : null,
]
  .filter((v): v is string => Boolean(v))
  .join(' / ');

const rows: { label: string; value: string }[] = [
  { label: '営業時間', value: shop.hours },
  { label: '定休日', value: shop.closedDays },
  { label: '住所', value: shop.address },
  ...(shop.parking ? [{ label: '駐車場', value: shop.parking }] : []),
  ...(seats ? [{ label: '席数', value: seats }] : []),
  ...(shop.takeout !== undefined
    ? [{ label: 'テイクアウト', value: shop.takeout ? '対応' : '非対応' }]
    : []),
  ...(shop.delivery !== undefined
    ? [{ label: '出前', value: shop.delivery ? '対応' : '非対応' }]
    : []),
  ...(shop.accessNote ? [{ label: 'アクセス', value: shop.accessNote }] : []),
  ...(shop.notes ? [{ label: 'ご案内', value: shop.notes }] : []),
];
---

<div class="grid gap-12 md:grid-cols-2 md:gap-10">
  <div class="reveal">
    {/* 電話はこのサイトで唯一の予約導線。表の一行に埋もれさせず、表の前に大きく置く */}
    <div class="border-y border-kinari-line py-6">
      <p class="text-xs tracking-[0.3em] text-rikyu">ご予約・お問い合わせ</p>
      <TelLink
        tel={shop.tel}
        class="mt-1 inline-block py-1 text-3xl text-bengara tabular-nums transition-opacity hover:opacity-70 sm:text-4xl"
      >
        {shop.tel}
      </TelLink>
    </div>

    <dl class="text-[0.9375rem] sm:text-base">
      {
        rows.map((row) => (
          <div class="grid grid-cols-[6rem_1fr] gap-4 border-b border-kinari-line py-4 sm:grid-cols-[6.5rem_1fr]">
            <dt class="text-rikyu">{row.label}</dt>
            <dd class="whitespace-pre-line text-sumi tabular-nums">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="reveal">
    <iframe
      src={mapSrc}
      class="h-80 w-full md:h-full md:min-h-96"
      style="border:0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`${shop.name}の地図`}
    />
  </div>
</div>
