---
import type { Shop } from '../lib/microcms';
import InstagramLink from './InstagramLink.astro';
import TelLink from './TelLink.astro';

export interface Props {
  shop: Shop;
}

const { shop } = Astro.props;

// API キー不要の検索埋め込み形式（住所は CMS 側の値をそのまま使うため、
// 店舗情報が更新されても地図の位置は自動的に追従する）
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${shop.name} ${shop.address}`)}&output=embed`;

// 席数は改行で並べる（テーブル座敷は卓の内訳があればそれを出す）
const seats = [
  shop.seatsCounter ? `カウンター ${shop.seatsCounter}席` : null,
  shop.seatsTableDetail
    ? `テーブル座敷 ${shop.seatsTableDetail}`
    : shop.seatsTable
      ? `テーブル座敷 ${shop.seatsTable}席`
      : null,
]
  .filter((v): v is string => Boolean(v))
  .join('\n');

const rows: { label: string; value: string }[] = [
  { label: '営業時間', value: shop.hours },
  { label: '定休日', value: shop.closedDays },
  { label: '住所', value: shop.address },
  ...(shop.parking ? [{ label: '駐車場', value: shop.parking }] : []),
  ...(seats ? [{ label: '席数', value: seats }] : []),
  ...(shop.payment ? [{ label: 'お支払い', value: shop.payment }] : []),
  ...(shop.takeout
    ? [{ label: 'テイクアウト', value: shop.takeoutNote ? `対応（${shop.takeoutNote}）` : '対応' }]
    : []),
  // 出前は対応している場合だけ載せる（「非対応」をわざわざ並べない）
  ...(shop.delivery ? [{ label: '出前', value: '対応' }] : []),
  ...(shop.notes ? [{ label: 'ご案内', value: shop.notes }] : []),
];
---

<div class="grid gap-12 sm:grid-cols-2 sm:gap-10">
  <dl class="text-sm sm:text-base">
    {
      rows.map((row) => (
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-kinari-line py-4">
          <dt class="text-rikyu">{row.label}</dt>
          <dd class="whitespace-pre-line text-sumi">{row.value}</dd>
        </div>
      ))
    }
    <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-kinari-line py-4">
      <dt class="text-rikyu">電話</dt>
      <dd>
        <TelLink tel={shop.tel} class="text-lg text-bengara tabular-nums">
          {shop.tel}
        </TelLink>
      </dd>
    </div>
    {
      shop.instagramUrl && (
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-kinari-line py-4">
          <dt class="text-rikyu">Instagram</dt>
          <dd>
            <InstagramLink url={shop.instagramUrl} class="text-lg text-bengara" />
          </dd>
        </div>
      )
    }
  </dl>
  <div>
    <iframe
      src={mapSrc}
      class="h-80 w-full sm:h-full sm:min-h-80"
      style="border:0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`${shop.name}の地図`}
    />
  </div>
</div>
