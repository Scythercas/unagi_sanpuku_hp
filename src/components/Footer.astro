---
import type { Shop } from '../lib/microcms';
import TelLink from './TelLink.astro';

export interface Props {
  shop: Shop;
}

const { shop } = Astro.props;
const year = new Date().getFullYear();
---

{/* 焦茶の地で締める。電話は最も重要な導線なので、どのページからも必ず届くようここに置く */}
<footer class="stripe-light bg-kogecha px-5 py-16 text-cream">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="heading text-2xl tracking-[0.14em]">{shop.name}</p>
        <p class="mt-5 text-sm leading-relaxed text-cream/80">{shop.address}</p>
        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-cream/80">
          {shop.hours}
        </p>
        <p class="mt-2 text-sm text-cream/80">定休日　{shop.closedDays}</p>
      </div>

      <div class="sm:text-right">
        <p class="heading text-xs text-karashi">ご予約・お問い合わせ</p>
        <TelLink tel={shop.tel} class="mt-2 block text-3xl font-bold tabular-nums text-cream">
          {shop.tel}
        </TelLink>
        {
          shop.instagramUrl && (
            <a
              href={shop.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-block rounded-full border-2 border-cream/40 px-4 py-1 text-sm text-cream/80 transition hover:border-cream hover:text-cream"
            >
              Instagram
            </a>
          )
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-cream/25 pt-6 text-xs text-cream/70 sm:flex-row sm:justify-between"
    >
      <p>&copy; {year} {shop.name}</p>
      <a href="/privacy" class="transition hover:text-cream">プライバシーポリシー</a>
    </div>
  </div>
</footer>
