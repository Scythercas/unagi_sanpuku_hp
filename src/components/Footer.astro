---
import type { Shop } from '../lib/microcms';
import InstagramLink from './InstagramLink.astro';
import TelLink from './TelLink.astro';

export interface Props {
  shop: Shop;
}

const { shop } = Astro.props;
const year = new Date().getFullYear();
---

{/* 墨地の締め。住所・営業時間は店舗案内に任せ、ここは店名と連絡手段だけに絞る。
    電話は最も重要な導線なので、どのページからも必ず届くようここに置く */}
<footer class="bg-sumi px-5 py-20 text-kinari">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
      <p class="font-brush text-4xl leading-none">{shop.name}</p>

      <div class="flex flex-col gap-4 sm:items-end">
        <TelLink tel={shop.tel} class="text-3xl tabular-nums text-kinari">
          {shop.tel}
        </TelLink>
        {
          shop.instagramUrl && (
            <InstagramLink
              url={shop.instagramUrl}
              class="text-base text-kinari transition hover:text-sumi-weak"
            />
          )
        }
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-sumi-line pt-8 text-xs text-sumi-weak sm:flex-row sm:justify-between"
    >
      <p>&copy; {year} {shop.name}</p>
      <a href="/privacy" class="transition hover:text-kinari">プライバシーポリシー</a>
    </div>
  </div>
</footer>
