---
import type { NewsItem } from '../lib/microcms';
import Section from './Section.astro';

export interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

{
  items.length > 0 && (
    <Section id="news" label="おしらせ" deep>
      <ul class="mx-auto max-w-2xl space-y-5">
        {items.map((item) => (
          <li class="signboard px-6 py-5">
            <div class="flex flex-wrap items-center gap-3">
              <time datetime={item.publishedAt} class="text-sm tabular-nums text-kogecha-dim">
                {formatDate(item.publishedAt)}
              </time>
              {item.important && (
                <span class="heading rounded-full bg-shu px-3 py-0.5 text-xs text-cream">
                  重要
                </span>
              )}
            </div>
            <h3 class="heading mt-2 text-lg text-kogecha">{item.title}</h3>
            <div
              class="mt-2 space-y-2 text-sm leading-relaxed text-kogecha-dim"
              set:html={item.body}
            />
          </li>
        ))}
      </ul>
    </Section>
  )
}
