---
import type { NewsItem } from '../lib/microcms';
import Section from './Section.astro';

export interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

{
  items.length > 0 && (
    <Section id="news" title="お知らせ">
      <ul class="mx-auto max-w-2xl space-y-6">
        {items.map((item) => (
          <li class="border-b border-stone-200 pb-6">
            <div class="flex flex-wrap items-center gap-3">
              <time datetime={item.publishedAt} class="text-sm text-stone-500">
                {formatDate(item.publishedAt)}
              </time>
              {item.important && (
                <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-700">
                  重要
                </span>
              )}
            </div>
            <h3 class="mt-1 font-semibold text-stone-900">{item.title}</h3>
            <div class="mt-2 space-y-2 text-sm leading-relaxed text-stone-700" set:html={item.body} />
          </li>
        ))}
      </ul>
    </Section>
  )
}
