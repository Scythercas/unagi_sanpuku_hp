---
import type { NewsItem } from '../lib/microcms';
import Section from './Section.astro';

export interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

{
  items.length > 0 && (
    <Section id="news" label="お知らせ">
      <ul class="max-w-2xl">
        {items.map((item) => (
          <li class="border-b border-tetsu-line py-6 first:pt-0">
            <div class="flex flex-wrap items-center gap-3">
              <time datetime={item.publishedAt} class="text-sm tabular-nums text-paper-dim">
                {formatDate(item.publishedAt)}
              </time>
              {item.important && (
                <span class="heading border border-paper px-2 py-0.5 text-[0.65rem] text-paper">
                  重要
                </span>
              )}
            </div>
            <h3 class="mt-2 text-lg text-paper">{item.title}</h3>
            <div
              class="mt-2 space-y-2 text-sm leading-relaxed text-paper-dim"
              set:html={item.body}
            />
          </li>
        ))}
      </ul>
    </Section>
  )
}
