---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getShop } from '../lib/microcms';

// 404.html を出力しておくと、GitHub Pages と Cloudflare Pages の
// どちらも存在しない URL でこのページを 404 として返す。
// 無いと Cloudflare Pages はトップページを 200 で返してしまう（ソフト404）。
const shop = await getShop();
const title = `ページが見つかりません｜${shop.name}`;
const description = `お探しのページは見つかりませんでした。${shop.name}のトップページへお戻りください。`;
---

<BaseLayout title={title} description={description}>
  {/* 検索結果に載せない */}
  <meta name="robots" content="noindex" slot="head" />

  <div class="flex min-h-[70svh] items-center justify-center px-5 py-24">
    <div class="text-center">
      <p class="section-label text-xs text-rikyu sm:text-sm">404</p>
      <div class="mx-auto my-7 h-px w-10 bg-bengara"></div>
      <h1 class="text-xl text-sumi sm:text-2xl">ページが見つかりません</h1>
      <p class="mt-6 leading-loose text-rikyu">
        お探しのページは移動または削除された可能性があります。
      </p>
      <a
        href="/"
        class="mt-10 inline-block border-b border-bengara pb-1 text-bengara transition hover:opacity-70"
      >
        {shop.name}のトップページへ
      </a>
    </div>
  </div>

  <Footer shop={shop} />
</BaseLayout>
