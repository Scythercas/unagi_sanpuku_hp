---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StructuredData from '../components/StructuredData.astro';
import Menu from '../components/Menu.astro';
import Gallery from '../components/Gallery.astro';
import ShopInfo from '../components/ShopInfo.astro';
import Recruit from '../components/Recruit.astro';
import News from '../components/News.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import { getGalleryList, getMenuList, getNewsList, getRecruit, getShop } from '../lib/microcms';
import { getLocalImage, imageMap } from '../lib/images';
import { groupMenuByCategory } from '../lib/content';

const [shop, menu, gallery, recruit, news] = await Promise.all([
  getShop(),
  getMenuList(),
  getGalleryList(),
  getRecruit(),
  getNewsList(),
]);

// ヒーローは図形で組むため写真を使わないが、OGP には実物の写真が要る
const ogGalleryItem = gallery.find((item) => item.type === '料理') ?? gallery[0];
const ogSourceImage = ogGalleryItem
  ? getLocalImage(imageMap.gallery[ogGalleryItem.id]?.localPath)
  : undefined;

const ogImageUrl = ogSourceImage
  ? new URL(
      (await getImage({ src: ogSourceImage, width: 1200, height: 630, format: 'jpg' })).src,
      Astro.site
    ).toString()
  : undefined;

const title = `${shop.name}｜北高崎のうなぎ専門店`;
const description =
  shop.catchcopy ??
  `群馬県高崎市（北高崎）のうなぎ専門店「${shop.name}」。うな重・うな丼をご用意しています。`;

const menuGroups = groupMenuByCategory(menu);
---

<BaseLayout title={title} description={description} ogImageUrl={ogImageUrl}>
  <StructuredData shop={shop} menu={menu} ogImageUrl={ogImageUrl} slot="head" />

  <Hero shopName={shop.name} catchcopy={shop.catchcopy} />

  {
    menuGroups.length > 0 && (
      <Section id="menu" label="おしながき" deep>
        <Menu groups={menuGroups} />
      </Section>
    )
  }

  {
    gallery.length > 0 && (
      <Section id="gallery" label="お店のようす">
        <Gallery items={gallery} />
      </Section>
    )
  }

  <Section id="access" label="お店のこと" deep>
    <ShopInfo shop={shop} />
  </Section>

  {
    recruit.isOpen && (
      <Section id="recruit" label="スタッフ募集">
        <Recruit recruit={recruit} />
      </Section>
    )
  }

  <News items={news} />
  <Footer shop={shop} />
</BaseLayout>
