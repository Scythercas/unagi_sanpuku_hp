---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StructuredData from '../components/StructuredData.astro';
import Intro from '../components/Intro.astro';
import Menu from '../components/Menu.astro';
import Gallery from '../components/Gallery.astro';
import ShopInfo from '../components/ShopInfo.astro';
import Recruit from '../components/Recruit.astro';
import News from '../components/News.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import PageIndex from '../components/PageIndex.astro';
import { getGalleryList, getMenuList, getNewsList, getRecruit, getShop } from '../lib/microcms';
import { getLocalImage, imageMap } from '../lib/images';
import { groupGalleryByType, groupMenuByCategory } from '../lib/content';

const [shop, menu, gallery, recruit, news] = await Promise.all([
  getShop(),
  getMenuList(),
  getGalleryList(),
  getRecruit(),
  getNewsList(),
]);

const heroGalleryItem = gallery.find((item) => item.type === '調理') ?? gallery[0];
const heroImage = heroGalleryItem
  ? getLocalImage(imageMap.gallery[heroGalleryItem.id]?.localPath)
  : undefined;

const ogImageUrl = heroImage
  ? new URL(
      (await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpg' })).src,
      Astro.site
    ).toString()
  : undefined;

const title = `${shop.name}｜北高崎のうなぎ専門店`;
const description =
  shop.catchcopy ??
  `群馬県高崎市（北高崎）のうなぎ専門店「${shop.name}」。落ち着いた雰囲気でうな重・うな丼をご提供しています。`;

const menuGroups = groupMenuByCategory(menu);
const galleryGroups = groupGalleryByType(gallery);

// ラベルはカタカナ（メニュー/ギャラリー）ではなく和語に寄せ、老舗の語彙で統一する。
// 中身の無いセクション・非公開の求人はそもそも出さない（目次にも載せない）。
const sections = [
  menuGroups.length > 0 ? { id: 'menu', label: 'お品書き' } : null,
  galleryGroups.length > 0 ? { id: 'gallery', label: '佇まい' } : null,
  { id: 'access', label: '店舗案内' },
  recruit.isOpen ? { id: 'recruit', label: '求人' } : null,
].filter((section): section is { id: string; label: string } => section !== null);
---

<BaseLayout title={title} description={description} ogImageUrl={ogImageUrl}>
  <StructuredData shop={shop} menu={menu} ogImageUrl={ogImageUrl} slot="head" />

  <Hero shopName={shop.name} heroImage={heroImage} heroAlt={shop.name} />
  <Intro catchcopy={shop.catchcopy} />
  <PageIndex items={sections} />

  {/* 臨時休業などは来店判断に直結するため、品書きより前に置く */}
  <News items={news} />

  {
    sections.map((section) => (
      <Section id={section.id} label={section.label}>
        {section.id === 'menu' && <Menu groups={menuGroups} />}
        {section.id === 'gallery' && <Gallery groups={galleryGroups} />}
        {section.id === 'access' && <ShopInfo shop={shop} />}
        {section.id === 'recruit' && <Recruit recruit={recruit} />}
      </Section>
    ))
  }

  <Footer shop={shop} />
</BaseLayout>
