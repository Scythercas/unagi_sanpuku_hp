---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StructuredData from '../components/StructuredData.astro';
import OwnerMessage from '../components/OwnerMessage.astro';
import Menu from '../components/Menu.astro';
import Gallery from '../components/Gallery.astro';
import ShopInfo from '../components/ShopInfo.astro';
import Recruit from '../components/Recruit.astro';
import News from '../components/News.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import { getGalleryList, getMenuList, getNewsList, getRecruit, getShop } from '../lib/microcms';
import { getLocalImage, imageMap } from '../lib/images';
import { splitFeaturedMenu } from '../lib/content';

const [shop, menu, gallery, recruit, news] = await Promise.all([
  getShop(),
  getMenuList(),
  getGalleryList(),
  getRecruit(),
  getNewsList(),
]);

// ヒーローは shop.heroImage を正とする。microCMS 側で未作成／未入力なら、
// 従来どおりギャラリーの「調理」→先頭 の順に代替する。
const heroFallback = gallery.find((item) => item.type === '調理') ?? gallery[0];
const heroImage =
  getLocalImage(imageMap.shop?.heroImage?.localPath) ??
  (heroFallback ? getLocalImage(imageMap.gallery[heroFallback.id]?.localPath) : undefined);

const ownerImage = getLocalImage(imageMap.shop?.ownerImage?.localPath);

const ogImageUrl = heroImage
  ? new URL(
      (await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpg' })).src,
      Astro.site
    ).toString()
  : undefined;

const title = `${shop.name}｜北高崎のうなぎ専門店`;
const description =
  shop.catchcopy ??
  `群馬県高崎市（北高崎）のうなぎ専門店「${shop.name}」。落ち着いた雰囲気でうな重・うな丼をご提供しています。`;

const menuSplit = splitFeaturedMenu(menu);
---

<BaseLayout title={title} description={description} ogImageUrl={ogImageUrl}>
  <StructuredData shop={shop} menu={menu} ogImageUrl={ogImageUrl} slot="head" />

  <Hero shopName={shop.name} heroImage={heroImage} />

  <OwnerMessage
    catchcopy={shop.catchcopy}
    ownerMessage={shop.ownerMessage}
    ownerName={shop.ownerName}
    ownerImage={ownerImage}
  />

  <Section id="menu" label="お品書き" deep>
    <Menu split={menuSplit} />
  </Section>

  <Section id="gallery" label="佇まい" bleed>
    <Gallery items={gallery} />
  </Section>

  <Section id="access" label="店舗案内" deep>
    <ShopInfo shop={shop} />
  </Section>

  {
    recruit.isOpen && (
      <Section id="recruit" label="求人">
        <Recruit recruit={recruit} />
      </Section>
    )
  }

  <News items={news} />
  <Footer shop={shop} />
</BaseLayout>
